# ── STT — Chimege /transcribe ─────────────────────────────────────────────────
@app.post("/api/stt")
async def speech_to_text(
    audio: Optional[UploadFile] = File(None),
    file: Optional[UploadFile] = File(None),
    language: str = Query("mn"),
):
    try:
        upload = audio or file
        if upload is None:
            raise HTTPException(
                status_code=422,
                detail="Audio file missing. Send form-data field name as 'audio' or 'file'.",
            )

        audio_bytes = await upload.read()
        if not audio_bytes:
            raise HTTPException(status_code=400, detail="Uploaded audio is empty")

        print(
            f"STT upload filename={upload.filename}, content_type={upload.content_type}, size={len(audio_bytes)}",
            flush=True,
        )

        suffix = ".m4a"
        if upload.filename:
            _, ext = os.path.splitext(upload.filename)
            if ext:
                suffix = ext

        tmp_in_path = None
        tmp_out_path = None
        try:
            with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as tmp_in:
                tmp_in.write(audio_bytes)
                tmp_in_path = tmp_in.name

            base, _ = os.path.splitext(tmp_in_path)
            tmp_out_path = base + ".wav"

            result = subprocess.run(
                [
                    "ffmpeg",
                    "-y",
                    "-i",
                    tmp_in_path,
                    "-ar",
                    "16000",
                    "-ac",
                    "1",
                    "-sample_fmt",
                    "s16",
                    "-f",
                    "wav",
                    tmp_out_path,
                ],
                capture_output=True,
            )
            if result.returncode != 0:
                err = result.stderr.decode(errors="ignore")
                print("FFMPEG ERROR:", err, flush=True)
                raise RuntimeError(f"ffmpeg: {err}")

            with open(tmp_out_path, "rb") as f:
                wav_bytes = f.read()
        finally:
            for path in [tmp_in_path, tmp_out_path]:
                if path:
                    try:
                        os.unlink(path)
                    except Exception:
                        pass

        print(f"STT wav size={len(wav_bytes)}", flush=True)

        # Chimege requires minimum WAV size 5KB. Avoid backend failure for short taps.
        if len(wav_bytes) < 5120:
            print("STT skipped: wav file too small for Chimege", flush=True)
            return {"text": "", "warning": "Audio too short. Please speak a little longer."}

        async with httpx.AsyncClient(timeout=60.0) as client:
            resp = await client.post(
                f"{CHIMEGE_BASE}/transcribe",
                content=wav_bytes,
                headers={
                    "Token": CHIMEGE_STT_TOKEN,
                    "Content-Type": "application/octet-stream",
                    "Punctuate": "true",
                },
            )

        print(
            f"CHIMEGE STT RESPONSE status={resp.status_code}, body={resp.text[:500]}",
            flush=True,
        )

        if resp.status_code != 200:
            raise HTTPException(
                status_code=502,
                detail=f"Chimege STT алдаа: status={resp.status_code}, body={resp.text}",
            )

        return {"text": resp.text.strip()}

    except HTTPException:
        raise
    except Exception as exc:
        print(f"STT BACKEND ERROR: {str(exc)}", flush=True)
        raise HTTPException(status_code=500, detail=str(exc))


# ── TTS — Chimege /synthesize ─────────────────────────────────────────────────
class TTSReq(BaseModel):
    text: str
    voice: str = "FEMALE3v2"
    speed: float = 1.0
    normalize: bool = True


@app.post("/api/tts")
async def text_to_speech(req: TTSReq):
    try:
        text = sanitize_tts_text(req.text)
        if not text:
            raise HTTPException(status_code=400, detail="text is required")

        if False and req.normalize and CHIMEGE_NORM_TOKEN:
            async with httpx.AsyncClient(timeout=30.0) as client:
                norm_resp = await client.post(
                    f"{CHIMEGE_BASE}/normalize-text",
                    content=text.encode("utf-8"),
                    headers={
                        "Token": CHIMEGE_NORM_TOKEN,
                        "Content-Type": "text/plain; charset=utf-8",
                    },
                )
            if norm_resp.status_code == 200:
                text = sanitize_tts_text(norm_resp.text.strip())

        async with httpx.AsyncClient(timeout=60.0) as client:
            tts_resp = await client.post(
                f"{CHIMEGE_BASE}/synthesize",
                content=text.encode("utf-8"),
                headers={
                    "Token": CHIMEGE_TTS_TOKEN,
                    "Content-Type": "text/plain; charset=utf-8",
                    "voice-id": req.voice,
                    "speed": str(req.speed),
                    "pitch": "1",
                    "sample-rate": "22050",
                },
            )

        if tts_resp.status_code != 200:
              print(
                  f"CHIMEGE TTS RESPONSE status={tts_resp.status_code}, body={tts_resp.text[:500]}",
                  flush=True
              )
              raise HTTPException(
                  status_code=502,
                  detail=f"Chimege TTS алдаа: status={tts_resp.status_code}, body={tts_resp.text}"
              )

        return Response(
            content=tts_resp.content,
            media_type="audio/x-wav",
            headers={"Content-Disposition": "inline; filename=tts.wav"},
        )

    except HTTPException:
        raise
    except Exception as exc:
        print(f"TTS BACKEND ERROR: {str(exc)}", flush=True)
        raise HTTPException(status_code=500, detail=str(exc))


# ── CHAT — GPT-4o function calling ───────────────────────────────────────────
class ChatReq(BaseModel):
    text: str
    system_prompt: str = ""
    tools: Optional[List[Any]] = None


@app.post("/api/chat")
async def chat(req: ChatReq):
    try:
        messages = []
        if req.system_prompt:
            messages.append({"role": "system", "content": req.system_prompt})
        messages.append({"role": "user", "content": req.text})

        payload: dict = {
            "model": "gpt-4o",
            "messages": messages,
            "temperature": 0.2,
        }
        if req.tools:
            payload["tools"] = req.tools
            payload["tool_choice"] = "required"

        async with httpx.AsyncClient(timeout=60.0) as client:
            resp = await client.post(
                f"{OPENAI_BASE}/chat/completions",
                json=payload,
                headers={
                    "Authorization": f"Bearer {OPENAI_API_KEY}",
                    "Content-Type": "application/json",
                },
            )

        if resp.status_code != 200:
            raise HTTPException(status_code=502, detail=f"OpenAI алдаа: {resp.text}")

        message = resp.json()["choices"][0]["message"]

        if message.get("tool_calls"):
            tc = message["tool_calls"][0]
            args = tc["function"].get("arguments") or "{}"
            return {
                "action": tc["function"]["name"],
                "params": json.loads(args),
                "rawMessage": message,
            }

        return {
            "action": "general_response",
            "params": {"message": message.get("content", "")},
            "rawMessage": message,
        }

    except HTTPException:
        raise
    except Exception as exc:
        print(f"CHAT BACKEND ERROR: {str(exc)}", flush=True)
        raise HTTPException(status_code=500, detail=str(exc))


# ── GMAIL — Send email via Gmail SMTP ─────────────────────────────────────────
class EmailReq(BaseModel):
    to: str
    subject: str
    body: str
    cc: Optional[str] = None
    bcc: Optional[str] = None


@app.post("/api/send-email")
async def send_email(req: EmailReq):
    try:
        if not GMAIL_USER or not GMAIL_APP_PASSWORD:
            raise HTTPException(
                status_code=500,
                detail="GMAIL_USER эсвэл GMAIL_APP_PASSWORD .env дээр тохируулагдаагүй байна",
            )

        recipients = [x.strip() for x in req.to.split(",") if x.strip()]
        if not recipients:
            raise HTTPException(status_code=400, detail="Recipient email is required")

        msg = EmailMessage()
        msg["From"] = GMAIL_USER
        msg["To"] = req.to
        msg["Subject"] = req.subject

        if req.cc:
            msg["Cc"] = req.cc
            recipients += [x.strip() for x in req.cc.split(",") if x.strip()]
        if req.bcc:
            recipients += [x.strip() for x in req.bcc.split(",") if x.strip()]

        msg.set_content(req.body)

        with smtplib.SMTP_SSL("smtp.gmail.com", 465, timeout=30) as smtp:
            smtp.login(GMAIL_USER, GMAIL_APP_PASSWORD)
            smtp.send_message(msg, from_addr=GMAIL_USER, to_addrs=recipients)

        print(f"GMAIL SENT to={req.to}, subject={req.subject}", flush=True)
        return {"ok": True, "message": "Email sent", "to": req.to, "subject": req.subject}

    except HTTPException:
        raise
    except Exception as exc:
        print(f"GMAIL SEND ERROR: {str(exc)}", flush=True)
        raise HTTPException(status_code=500, detail=f"Gmail илгээх алдаа: {str(exc)}")


# ── BRIEFING — GPT-4o daily summary ──────────────────────────────────────────
class BriefReq(BaseModel):
    period: str
    tasks: List[Any] = []
    events: List[Any] = []
    user_name: str = "Хэрэглэгч"


@app.post("/api/briefing")
async def briefing(req: BriefReq):
    try:
        tasks_text = "\n".join([f"- {t.get('title', '')}" for t in req.tasks]) or "Ажил алга"
        events_text = "\n".join([f"- {e.get('title', '')} ({e.get('startTime', '')})" for e in req.events]) or "Уулзалт алга"

        if req.period == "morning":
            prompt = f"Өнөөдрийн өглөөний товч мэдээлэл өг.\nАжлууд:\n{tasks_text}\nУулзалтууд:\n{events_text}"
        else:
            prompt = f"Өнөөдрийн оройн дүгнэлт хий.\nАжлууд:\n{tasks_text}\nУулзалтууд:\n{events_text}"

        async with httpx.AsyncClient(timeout=60.0) as client:
            resp = await client.post(
                f"{OPENAI_BASE}/chat/completions",
                json={
                    "model": "gpt-4o",
                    "messages": [
                        {
                            "role": "system",
                            "content": f"Та {req.user_name}-н хувийн туслах. Монголоор товч, урам зоригтой briefing өг. 2-3 өгүүлбэр.",
                        },
                        {"role": "user", "content": prompt},
                    ],
                    "temperature": 0.7,
                },
                headers={
                    "Authorization": f"Bearer {OPENAI_API_KEY}",
                    "Content-Type": "application/json",
                },
            )

        if resp.status_code != 200:
            raise HTTPException(status_code=502, detail=f"OpenAI алдаа: {resp.text}")

        text = resp.json()["choices"][0]["message"]["content"]
        return {"text": text}

    except HTTPException:
        raise
    except Exception as exc:
        print(f"BRIEFING BACKEND ERROR: {str(exc)}", flush=True)
        raise HTTPException(status_code=500, detail=str(exc))
