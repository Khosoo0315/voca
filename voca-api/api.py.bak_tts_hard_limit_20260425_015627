def sanitize_tts_text(text: str) -> str:
    t = str(text or "")

    # Email хаяг, URL зэргийг кирилл үгээр солино
    t = re.sub(
        r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}",
        " мэйл хаяг ",
        t
    )
    t = re.sub(r"https?://\S+|www\.\S+", " холбоос ", t)

    # Түгээмэл тэмдэгтүүдийг үгээр солино
    replacements = {
        "@": " эт ",
        "#": " ",
        "$": " ",
        "%": " хувь ",
        "&": " ба ",
        "/": " ",
        "\\": " ",
        "(": " ",
        ")": " ",
        "[": " ",
        "]": " ",
        "{": " ",
        "}": " ",
        "_": " ",
        "+": " ",
        "=": " ",
        "*": " ",
        ";": ",",
        "“": '"',
        "”": '"',
        "‘": "'",
        "’": "'",
        "\n": " ",
        "\r": " ",
        "\t": " ",
    }

    for k, v in replacements.items():
        t = t.replace(k, v)

    # Тоонуудыг кирилл үгээр солино. Chimege TTS тоон digit дээр 400 өгч байна.
    digit_words = {
        "0": " тэг ",
        "1": " нэг ",
        "2": " хоёр ",
        "3": " гурав ",
        "4": " дөрөв ",
        "5": " тав ",
        "6": " зургаа ",
        "7": " долоо ",
        "8": " найм ",
        "9": " ес ",
    }

    for k, v in digit_words.items():
        t = t.replace(k, v)

    # Latin үсэг, emoji, бусад special тэмдэгтүүдийг устгана
    # Chimege зөвшөөрдөг: Cyrillic, space, ?, !, dot, hyphen, quotes, colon, comma
    t = re.sub(r"[^А-Яа-яӨөҮүЁё\s\?\!\.\,\-\:\'\"\ ]", " ", t)

    # Давхар цэг таслал, олон зайг цэвэрлэнэ
    t = re.sub(r"\s+", " ", t).strip()
    t = re.sub(r"\.{2,}", ".", t)

    return t or "Амжилттай."

OPENAI_BASE = "https://api.openai.com/v1"


