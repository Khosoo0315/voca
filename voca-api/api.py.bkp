"""
Voca AI — FastAPI Backend v2.0
Chimege STT/TTS (Mongolian) + OpenAI GPT-4o
"""

from fastapi import FastAPI, UploadFile, File, HTTPException, Query
from fastapi.responses import Response
from pydantic import BaseModel
from typing import Optional, List, Any
import os, json, subprocess, tempfile, httpx

app = FastAPI(title="Voca AI API", version="2.0.0")

# ── Credentials ───────────────────────────────────────────────────────────────
OPENAI_API_KEY     = os.getenv("OPENAI_API_KEY", "")
CHIMEGE_STT_TOKEN  = os.getenv("CHIMEGE_STT_TOKEN", "")
CHIMEGE_TTS_TOKEN  = os.getenv("CHIMEGE_TTS_TOKEN", "")
CHIMEGE_NORM_TOKEN = os.getenv("CHIMEGE_NORM_TOKEN", "")   # text normalization

CHIMEGE_BASE = "https://api.chimege.com/v1.2"
OPENAI_BASE  = "https://api.openai.com/v1"

# ── Health ────────────────────────────────────────────────────────────────────
@app.get("/ping")
def ping():
    return {"status": "ok", "service": "voca-api", "version": "2.0.0"}

# ── STT — Chimege /transcribe ─────────────────────────────────────────────────
@app.post("/api/stt")
async def speech_to_text(
    audio: UploadFile = File(...),
    language: str = Query("mn"),
):
    try:
        audio_bytes = await audio.read()

        # Write input file
        suffix = ".m4a"
        with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as tmp_in:
            tmp_in.write(audio_bytes)
            tmp_in_path = tmp_in.name

        base, _ = os.path.splitext(tmp_in_path)
        tmp_out_path = base + ".wav"

        # Convert to 16 kHz mono WAV (required by Chimege)
        result = subprocess.run(
            [
                "ffmpeg", "-y", "-i", tmp_in_path,
                "-ar", "16000", "-ac", "1",
                "-sample_fmt", "s16", "-f", "wav", tmp_out_path,
            ],
            capture_output=True,
        )
        if result.returncode != 0:
            raise RuntimeError(f"ffmpeg: {result.stderr.decode()}")

        with open(tmp_out_path, "rb") as f:
            wav_bytes = f.read()

        os.unlink(tmp_in_path)
        os.unlink(tmp_out_path)

        # Chimege STT — raw WAV bytes
        async with httpx.AsyncClient(timeout=60.0) as client:
            resp = await client.post(
                f"{CHIMEGE_BASE}/transcribe",
                content=wav_bytes,
                headers={
                    "Token": CHIMEGE_STT_TOKEN,
                    "Content-Type": "application/octet-stream",
                    "Punctuate": "true",
                },
            )

        if resp.status_code != 200:
            raise HTTPException(status_code=502, detail=f"Chimege STT алдаа: {resp.text}")

        return {"text": resp.text.strip()}

    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))


# ── TTS — Chimege /synthesize ─────────────────────────────────────────────────
class TTSReq(BaseModel):
    text: str
    voice: str = "FEMALE3v2"
    speed: float = 1.0
    normalize: bool = True

@app.post("/api/tts")
async def text_to_speech(req: TTSReq):
    try:
        text = req.text

        # Optional: normalize Mongolian text (numbers, abbreviations)
        if req.normalize and CHIMEGE_NORM_TOKEN:
            async with httpx.AsyncClient(timeout=30.0) as client:
                norm_resp = await client.post(
                    f"{CHIMEGE_BASE}/normalize-text",
                    content=text.encode("utf-8"),
                    headers={
                        "Token": CHIMEGE_NORM_TOKEN,
                        "Content-Type": "text/plain; charset=utf-8",
                    },
                )
            if norm_resp.status_code == 200:
                text = norm_resp.text.strip()

        # Chimege TTS — returns audio/x-wav
        async with httpx.AsyncClient(timeout=60.0) as client:
            tts_resp = await client.post(
                f"{CHIMEGE_BASE}/synthesize",
                content=text.encode("utf-8"),
                headers={
                    "Token": CHIMEGE_TTS_TOKEN,
                    "Content-Type": "text/plain; charset=utf-8",
                    "voice-id": req.voice,
                    "speed": str(req.speed),
                    "pitch": "1",
                    "sample-rate": "22050",
                },
            )

        if tts_resp.status_code != 200:
            raise HTTPException(status_code=502, detail=f"Chimege TTS алдаа: {tts_resp.text}")

        return Response(
            content=tts_resp.content,
            media_type="audio/x-wav",
            headers={"Content-Disposition": "inline; filename=tts.wav"},
        )

    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))


# ── CHAT — GPT-4o function calling ───────────────────────────────────────────
class ChatReq(BaseModel):
    text: str
    system_prompt: str = ""
    tools: Optional[List[Any]] = None

@app.post("/api/chat")
async def chat(req: ChatReq):
    try:
        messages = []
        if req.system_prompt:
            messages.append({"role": "system", "content": req.system_prompt})
        messages.append({"role": "user", "content": req.text})

        payload: dict = {
            "model": "gpt-4o",
            "messages": messages,
            "temperature": 0.3,
        }
        if req.tools:
            payload["tools"] = req.tools
            payload["tool_choice"] = "required"

        async with httpx.AsyncClient(timeout=60.0) as client:
            resp = await client.post(
                f"{OPENAI_BASE}/chat/completions",
                json=payload,
                headers={
                    "Authorization": f"Bearer {OPENAI_API_KEY}",
                    "Content-Type": "application/json",
                },
            )

        if resp.status_code != 200:
            raise HTTPException(status_code=502, detail=f"OpenAI алдаа: {resp.text}")

        message = resp.json()["choices"][0]["message"]

        if message.get("tool_calls"):
            tc = message["tool_calls"][0]
            return {
                "action": tc["function"]["name"],
                "params": json.loads(tc["function"]["arguments"]),
                "rawMessage": message,
            }

        return {
            "action": "general_response",
            "params": {"message": message.get("content", "")},
            "rawMessage": message,
        }

    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))


# ── BRIEFING — GPT-4o daily summary ──────────────────────────────────────────
class BriefReq(BaseModel):
    period: str
    tasks: List[Any] = []
    events: List[Any] = []
    user_name: str = "Хэрэглэгч"

@app.post("/api/briefing")
async def briefing(req: BriefReq):
    try:
        tasks_text  = "\n".join([f"- {t.get('title','')}" for t in req.tasks])  or "Ажил алга"
        events_text = "\n".join([f"- {e.get('title','')} ({e.get('startTime','')})" for e in req.events]) or "Уулзалт алга"

        if req.period == "morning":
            prompt = f"Өнөөдрийн өглөөний товч мэдээлэл өг.\nАжлууд:\n{tasks_text}\nУулзалтууд:\n{events_text}"
        else:
            prompt = f"Өнөөдрийн оройн дүгнэлт хий.\nАжлууд:\n{tasks_text}\nУулзалтууд:\n{events_text}"

        async with httpx.AsyncClient(timeout=60.0) as client:
            resp = await client.post(
                f"{OPENAI_BASE}/chat/completions",
                json={
                    "model": "gpt-4o",
                    "messages": [
                        {
                            "role": "system",
                            "content": (
                                f"Та {req.user_name}-н хувийн туслах. "
                                "Монголоор товч, урам зоригтой briefing өг. 2-3 өгүүлбэр."
                            ),
                        },
                        {"role": "user", "content": prompt},
                    ],
                    "temperature": 0.7,
                },
                headers={
                    "Authorization": f"Bearer {OPENAI_API_KEY}",
                    "Content-Type": "application/json",
                },
            )

        if resp.status_code != 200:
            raise HTTPException(status_code=502, detail=f"OpenAI алдаа: {resp.text}")

        return {"text": resp.json()["choices"][0]["message"]["content"]}

    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
