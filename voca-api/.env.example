# OpenAI
OPENAI_API_KEY=sk-...
# Override only if using a proxy / Azure / custom gateway.
# OPENAI_BASE=https://api.openai.com/v1

# Chimege (Mongolian STT / TTS / text normalization)
CHIMEGE_STT_TOKEN=
CHIMEGE_TTS_TOKEN=
CHIMEGE_NORM_TOKEN=

# Gmail SMTP (use a Google App Password, not the account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# CORS: comma-separated list of allowed origins, or "*" for any (no credentials).
# Example: CORS_ORIGINS=https://voca.example.com,http://localhost:19006
CORS_ORIGINS=*
